# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Minimax via OpenAI-compatible API
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=M3.0

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Moss
MOSS_PROJECT_ID=your-moss-project-id
MOSS_PROJECT_KEY=your-moss-project-key
MOSS_INDEX_NAME=antidote-due-diligence

# Unsiloed
UNSILOED_API_KEY=your-unsiloed-api-key

# Note: STT (Deepgram) and TTS (Cartesia) are routed through LiveKit Inference,
# so no separate Deepgram/Cartesia API keys are needed — they're billed via
# your LiveKit API key.
